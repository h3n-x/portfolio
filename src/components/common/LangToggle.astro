---
import { Languages } from '@lucide/astro';
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const targetLang = lang === 'es' ? 'en' : 'es';
const targetHref = `/${targetLang}/`;
const label = lang === 'es' ? 'EN' : 'ES';
---

<a
  href={targetHref}
  data-astro-reload
  class="interactive-target px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide border border-(--border-subtle) bg-(--bg-surface) text-(--text-secondary) hover:text-(--text-primary) hover:border-(--border-default) transition-all flex items-center gap-1.5"
  aria-label={t('lang.toggle')}
  title={t('lang.toggle')}
>
  <Languages class="w-3.5 h-3.5 text-(--accent-forest)" aria-hidden="true" />
  <span>{label}</span>
</a>
