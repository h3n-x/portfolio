---
import { getCollection } from 'astro:content';
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { Briefcase, Calendar } from '@lucide/astro';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const experiences = (await getCollection('experience', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="experiencia" class="flex flex-col gap-6" aria-labelledby="experience-title">
  <!-- Section Header -->
  <div class="flex flex-col gap-1 border-b border-(--border-subtle) pb-3">
    <h2 id="experience-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-(--text-primary)">
      {t('experience.title')}
    </h2>
    <p class="text-sm text-(--text-muted)">
      {t('experience.subtitle')}
    </p>
  </div>

  <div class="flex flex-col gap-6">
    {experiences.map((exp) => (
      <article class="ghibli-card p-6 sm:p-7 flex flex-col gap-4 bg-(--bg-surface)">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="flex flex-col gap-0.5">
            <h3 class="text-lg sm:text-xl font-bold text-(--text-primary)">
              {exp.data.title}
            </h3>
            <span class="text-sm font-semibold text-(--accent-forest)">
              {exp.data.role}
            </span>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-medium text-(--text-muted) px-2.5 py-1 rounded-md bg-(--bg-elevated) self-start sm:self-auto border border-(--border-subtle)">
            <Calendar class="w-3.5 h-3.5 text-(--accent-primary)" aria-hidden="true" />
            <time>{exp.data.period}</time>
          </div>
        </div>

        <p class="text-sm sm:text-base text-(--text-secondary) leading-relaxed">
          {exp.data.description}
        </p>

        <!-- Achievements -->
        <div class="flex flex-col gap-2 pt-1">
          <h4 class="text-xs font-bold uppercase tracking-wider text-(--text-muted)">
            {t('experience.achievementsLabel')}
          </h4>
          <ul class="flex flex-col gap-2 text-sm text-(--text-secondary)" role="list">
            {exp.data.achievements.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-(--accent-primary) mt-1 shrink-0">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tech tags -->
        <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-(--border-subtle)">
          {exp.data.technologies.map((tech) => (
            <span class="px-2 py-0.5 rounded text-xs font-medium bg-(--bg-elevated) text-(--text-muted) border border-(--border-subtle)">
              {tech}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
