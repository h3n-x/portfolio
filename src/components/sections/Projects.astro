---
import { getCollection } from 'astro:content';
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { ExternalLink, ArrowUpRight, ChevronDown } from '@lucide/astro';
import { categoryIconFor } from './projectIcons';
import GithubIcon from '../icons/GithubIcon.astro';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Load projects from content collection matching current language: featured first, then by order
const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);

// Filters: "all" shows the featured projects and a button for the rest; an area shows all of its projects.
const areaFilters = [
  { id: 'all', label: t('projects.filterAll') },
  { id: 'security', label: t('projects.filterSecurity') },
  { id: 'linux', label: t('projects.filterLinux') },
  { id: 'backend', label: t('projects.filterBackend') },
  { id: 'web', label: t('projects.filterWeb') },
].map((f) => ({
  ...f,
  count: f.id === 'all' ? projects.length : projects.filter((p) => p.data.areas.includes(f.id as never)).length,
})).filter((f) => f.count > 0);
const featuredCount = projects.filter((p) => p.data.featured).length;
---

<section id="proyectos" class="flex flex-col gap-8" aria-labelledby="projects-title">
  <!-- Section Header -->
  <div class="flex flex-col gap-2 border-b border-(--border-subtle) pb-3">
    <div class="flex items-center justify-between">
      <h2 id="projects-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-(--text-primary)">
        {t('projects.title')}
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-(--accent-forest-bg) text-(--accent-forest) border border-(--border-subtle)">
        {projects.length} {lang === 'es' ? 'Casos de Estudio' : 'Case Studies'}
      </span>
    </div>
    <p class="text-sm text-(--text-muted)">
      {t('projects.subtitle')}
    </p>
  </div>

  <!-- Area filters (shown by the script; without JS every project is visible) -->
  <div class="project-filters flex flex-wrap items-center gap-2 -mt-2" role="group" aria-label={t('projects.filterLabel')} hidden>
    {areaFilters.map((filter) => (
      <button
        type="button"
        data-filter={filter.id}
        aria-pressed={filter.id === 'all' ? 'true' : 'false'}
        aria-controls="projects-grid"
        class="project-filter interactive-target text-xs font-semibold px-3 py-1.5 rounded-full border border-(--border-subtle) bg-(--bg-surface) text-(--text-secondary) hover:border-(--border-strong) hover:text-(--text-primary) transition-colors cursor-pointer flex items-center gap-1.5"
      >
        <span>{filter.label}</span>
        <span class="project-filter-count text-[11px] font-mono px-1.5 rounded-full bg-(--bg-elevated) text-(--text-muted)">{filter.count}</span>
      </button>
    ))}
  </div>

  <!-- Project grid -->
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => {
      const projectAnchor = project.slug.split('/').pop() || project.slug;
      const CategoryIcon = categoryIconFor(projectAnchor);

      return (
        <article
          id={projectAnchor}
          data-areas={project.data.areas.join(' ')}
          data-featured={project.data.featured ? 'true' : 'false'}
          class="project-card ghibli-card p-5 sm:p-6 flex flex-col justify-between gap-5 bg-(--bg-surface) rounded-2xl border border-(--border-subtle) hover:border-(--border-strong) transition-all duration-300 group cursor-pointer shadow-xs hover:shadow-md"
          data-modal-target={`modal-${projectAnchor}`}
        >
          <!-- Top Row: Category & Status Badges -->
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="text-xs px-2.5 py-1 rounded-full bg-(--accent-sky-bg) text-(--accent-sky) font-medium border border-(--border-subtle) flex items-center gap-1.5">
              <CategoryIcon class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
              <span>{project.data.category}</span>
            </span>

            <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-(--accent-forest-bg) text-(--accent-forest) border border-(--border-subtle) font-mono">
              {project.data.status}
            </span>
          </div>

          <!-- Visual Cover with Hover Overlay -->
          <div class="rounded-xl overflow-hidden border border-(--border-subtle) bg-(--bg-elevated) relative aspect-[16/9] flex items-center justify-center">
            <img
              src={`/images/projects/card-${projectAnchor}.svg`}
              alt={t('projects.imageAlt').replace('{title}', project.data.title)}
              width="1200"
              height="675"
              class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center backdrop-blur-xs">
              <span class="px-3.5 py-1.5 rounded-xl bg-(--bg-surface)/95 text-xs font-semibold text-(--text-primary) shadow-lg border border-(--border-default) flex items-center gap-1.5 transform translate-y-1 group-hover:translate-y-0 transition-transform">
                <ArrowUpRight class="w-3.5 h-3.5 text-(--accent-forest)" />
                <span>{t('projects.inspectCta')}</span>
              </span>
            </div>
          </div>

          <!-- Project Title & Tagline -->
          <div class="flex flex-col gap-2">
            <h3 class="text-xl font-bold text-(--text-primary) group-hover:text-(--accent-forest) transition-colors flex items-center justify-between">
              <span>{project.data.title}</span>
              <ArrowUpRight class="w-4 h-4 opacity-0 group-hover:opacity-100 text-(--accent-forest) transition-opacity shrink-0" />
            </h3>
            <p class="text-sm text-(--text-secondary) leading-relaxed line-clamp-2">
              {project.data.tagline}
            </p>
          </div>

          <!-- Tech Stack Pills (Preview top 4) -->
          <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-(--border-subtle)">
            {project.data.technologies.slice(0, 4).map((tech) => (
              <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-(--bg-elevated) text-(--text-secondary) border border-(--border-subtle)">
                {tech}
              </span>
            ))}
            {project.data.technologies.length > 4 && (
              <span class="px-2 py-0.5 rounded-md text-[11px] font-medium text-(--text-muted)">
                +{project.data.technologies.length - 4}
              </span>
            )}
          </div>

          <!-- Action Footer: Trigger Button + External Links -->
          <div class="flex items-center justify-between pt-3 border-t border-(--border-subtle)">
            <button
              type="button"
              data-modal-target={`modal-${projectAnchor}`}
              aria-haspopup="dialog"
              class="interactive-target text-xs font-semibold text-(--accent-forest) hover:text-(--text-primary) flex items-center gap-1 group-hover:translate-x-0.5 transition-all"
            >
              <span>{t('projects.inspectCta')}<span class="sr-only">: {project.data.title}</span></span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </button>

            <div class="flex items-center gap-2" onclick="event.stopPropagation()">
              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="interactive-target p-2 rounded-lg text-(--text-muted) hover:text-(--accent-forest) hover:bg-(--bg-elevated) transition-colors"
                  aria-label={`${t('projects.viewDemo')} (${project.data.title})`}
                >
                  <ExternalLink class="w-4 h-4" />
                </a>
              )}
              <a
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="interactive-target p-2 rounded-lg text-(--text-muted) hover:text-(--text-primary) hover:bg-(--bg-elevated) transition-colors"
                aria-label={`${t('projects.viewCode')} (${project.data.title})`}
              >
                <GithubIcon class="w-4 h-4" />
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Expands the "all" view beyond the featured projects -->
  {projects.length > featuredCount && (
    <div class="flex justify-center -mt-2">
      <button
        type="button"
        class="projects-toggle interactive-target text-xs font-semibold px-4 py-2 rounded-xl border border-(--border-default) bg-(--bg-surface) text-(--text-secondary) hover:text-(--text-primary) hover:border-(--accent-forest) transition-colors cursor-pointer flex items-center gap-1.5"
        aria-controls="projects-grid"
        aria-expanded="false"
        data-label-more={t('projects.showAll').replace('{n}', String(projects.length))}
        data-label-less={t('projects.showLess')}
        hidden
      >
        <span class="projects-toggle-label">{t('projects.showAll').replace('{n}', String(projects.length))}</span>
        <ChevronDown class="projects-toggle-icon w-3.5 h-3.5 transition-transform" aria-hidden="true" />
      </button>
    </div>
  )}
  <p class="projects-status sr-only" aria-live="polite" data-template={t('projects.showing')}></p>

  <!-- Case study dialogs: empty shells, filled from /<lang>/case-studies/<slug>/ on first open -->
  {projects.map((project) => {
    const projectAnchor = project.slug.split('/').pop() || project.slug;

    return (
      <dialog
        id={`modal-${projectAnchor}`}
        class="project-modal fixed inset-0 m-auto w-[94vw] max-w-4xl max-h-[90vh] rounded-2xl bg-(--bg-surface) text-(--text-primary) border border-(--border-default) shadow-2xl p-0 overflow-hidden z-50 focus:outline-none"
        aria-label={project.data.title}
        aria-modal="true"
        data-src={`/${lang}/case-studies/${projectAnchor}/`}
      >
        <div class="px-6 py-10 flex flex-col items-center gap-4 text-center">
          <p class="modal-status text-sm text-(--text-muted)" data-error={t('projects.loadError')}>{t('projects.loading')}</p>
          <button type="button" class="modal-close-btn interactive-target px-4 py-2 rounded-xl text-xs font-semibold bg-(--bg-elevated) text-(--text-secondary) hover:text-(--text-primary) border border-(--border-default) transition-colors cursor-pointer">
            {t('projects.modalClose')}
          </button>
        </div>
      </dialog>
    );
  })}
</section>

<style>
  .project-card.is-entering {
    animation: project-enter 220ms ease-out;
  }
  .project-filter[aria-pressed='true'] {
    background: var(--accent-forest-bg);
    color: var(--accent-forest);
    border-color: var(--accent-forest);
  }
  .projects-toggle[aria-expanded='true'] .projects-toggle-icon {
    transform: rotate(180deg);
  }
  @keyframes project-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card.is-entering { animation: none; }
  }
</style>

<script>
  // Filters and "show all": without JS every card stays visible and the controls stay hidden.
  function setupProjectFilters() {
    const section = document.getElementById('proyectos');
    if (!section || section.dataset.filtersReady) return;
    section.dataset.filtersReady = 'true';

    const cards = [...section.querySelectorAll<HTMLElement>('.project-card')];
    const chips = [...section.querySelectorAll<HTMLButtonElement>('.project-filter')];
    const toggle = section.querySelector<HTMLButtonElement>('.projects-toggle');
    const status = section.querySelector<HTMLElement>('.projects-status');
    let filter = 'all';
    let expanded = false;

    function apply(animate: boolean) {
      let shown = 0;
      cards.forEach((card) => {
        const inArea = filter === 'all' || (card.dataset.areas ?? '').split(' ').includes(filter);
        const visible = inArea && (filter !== 'all' || expanded || card.dataset.featured === 'true');
        if (visible) shown++;
        if (visible && card.hidden && animate) {
          card.classList.remove('is-entering');
          void card.offsetWidth;
          card.classList.add('is-entering');
        }
        card.hidden = !visible;
      });
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter)));
      if (toggle) {
        toggle.hidden = filter !== 'all';
        toggle.setAttribute('aria-expanded', String(expanded));
        const label = toggle.querySelector('.projects-toggle-label');
        if (label) label.textContent = (expanded ? toggle.dataset.labelLess : toggle.dataset.labelMore) ?? '';
      }
      if (status && animate) {
        status.textContent = (status.dataset.template ?? '')
          .replace('{shown}', String(shown))
          .replace('{total}', String(cards.length));
      }
    }

    chips.forEach((chip) => chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? 'all';
      apply(true);
    }));
    toggle?.addEventListener('click', () => {
      expanded = !expanded;
      apply(true);
      if (!expanded) toggle.scrollIntoView({ block: 'nearest' });
    });

    // A link to a project that starts hidden (#yt-cli) opens the full list
    const target = location.hash.slice(1);
    if (target && cards.some((card) => card.id === target && card.dataset.featured !== 'true')) expanded = true;

    section.querySelector<HTMLElement>('.project-filters')?.removeAttribute('hidden');
    apply(false);
  }

  function setupProjectModals() {
    let lastActiveElement: HTMLElement | null = null;

    // Ensure all modals start closed on load
    const modals = document.querySelectorAll<HTMLDialogElement>('dialog.project-modal');
    modals.forEach((modal) => {
      if (modal.hasAttribute('open')) {
        modal.close();
      }
    });

    // The case study comes from /<lang>/case-studies/<slug>/ the first time it is needed
    const loads = new Map<string, Promise<void>>();
    function loadContent(modal: HTMLDialogElement): Promise<void> {
      const src = modal.dataset.src;
      if (!src || modal.dataset.loaded) return Promise.resolve();
      let load = loads.get(modal.id);
      if (!load) {
        load = fetch(src)
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.text();
          })
          .then((html) => {
            const fragment = document.createElement('template');
            fragment.innerHTML = html;
            fragment.content.querySelectorAll('link, script, meta, style').forEach((node) => node.remove());
            modal.replaceChildren(fragment.content);
            modal.dataset.loaded = 'true';
          })
          .catch(() => {
            loads.delete(modal.id);
            const status = modal.querySelector<HTMLElement>('.modal-status');
            if (status) status.textContent = status.dataset.error ?? '';
          });
        loads.set(modal.id, load);
      }
      return load;
    }

    // Helper to open modal
    function openModal(modalId: string, triggerEl?: HTMLElement) {
      const modal = document.getElementById(modalId) as HTMLDialogElement | null;
      if (!modal) return;
      void loadContent(modal);
      lastActiveElement = triggerEl || (document.activeElement as HTMLElement);
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      modal.showModal();
    }

    // Helper to close modal
    function closeModal(modal: HTMLDialogElement) {
      modal.close();
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    // Bind triggers (card clicks & buttons)
    const triggers = document.querySelectorAll<HTMLElement>('[data-modal-target]');
    triggers.forEach((trigger) => {
      const targetId = trigger.getAttribute('data-modal-target');
      if (!targetId) return;

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(targetId, trigger);
      });

      // Pointer or focus on a card: fetch its case study ahead so the dialog opens filled
      const warm = () => {
        const modal = document.getElementById(targetId) as HTMLDialogElement | null;
        if (modal) void loadContent(modal);
      };
      trigger.addEventListener('pointerenter', warm, { once: true });
      trigger.addEventListener('focusin', warm, { once: true });

    });

    // Handle dialog events
    modals.forEach((modal) => {
      // Close buttons
      const closeButtons = modal.querySelectorAll('.modal-close-btn');
      closeButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          closeModal(modal);
        });
      });

      // Backdrop click closes dialog (e.target is dialog when clicking backdrop)
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal(modal);
          return;
        }
        const rect = modal.getBoundingClientRect();
        const isInDialog =
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width;
        if (!isInDialog) {
          closeModal(modal);
        }
      });

      // Restore scroll when closed
      modal.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
          lastActiveElement.focus();
        }
      });
    });

    // Global Escape key listener fallback
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openModalEl = document.querySelector<HTMLDialogElement>('dialog.project-modal[open]');
        if (openModalEl) {
          e.preventDefault();
          closeModal(openModalEl);
        }
      }
    });
  }

  // Run on initial page load and after Astro View Transitions swap
  setupProjectModals();
  setupProjectFilters();
  document.addEventListener('astro:page-load', setupProjectModals);
  document.addEventListener('astro:page-load', setupProjectFilters);
</script>
