---
import { getCollection } from 'astro:content';
import type { SupportedLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { ShieldAlert, Layers, BookOpen, Terminal, ShieldCheck, Container, Lock, ExternalLink } from '@lucide/astro';
import GithubIcon from '../icons/GithubIcon.astro';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Load projects from content collection matching current language and sort by order
const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="proyectos" class="flex flex-col gap-8" aria-labelledby="projects-title">
  <!-- Section Header -->
  <div class="flex flex-col gap-2 border-b border-(--border-subtle) pb-3">
    <div class="flex items-center justify-between">
      <h2 id="projects-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-(--text-primary)">
        {t('projects.title')}
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-(--accent-forest-bg) text-(--accent-forest) border border-(--border-subtle)">
        {projects.length} {lang === 'es' ? 'Casos de Estudio' : 'Case Studies'}
      </span>
    </div>
    <p class="text-sm text-(--text-muted)">
      {t('projects.subtitle')}
    </p>
  </div>

  <!-- Semantic Progression: 4-Layer Infrastructure Defense in Depth -->
  <nav aria-label={t('projects.layerNav')} class="w-full">
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 w-full" role="list">
      <li class="flex">
        <a
          href="#archforge"
          class="interactive-target w-full p-3.5 rounded-xl bg-(--bg-surface) border border-(--border-subtle) hover:border-(--accent-forest) transition-all flex flex-col gap-1 group shadow-xs focus-visible:outline-2 focus-visible:outline-(--accent-forest)"
        >
          <div class="flex items-center justify-between text-xs text-(--text-muted)">
            <span class="font-semibold text-(--accent-forest)">{lang === 'es' ? 'Capa 1' : 'Layer 1'}</span>
            <span class="text-[11px] font-mono text-(--text-muted)">Host / OS</span>
          </div>
          <span class="text-sm font-bold text-(--text-primary) group-hover:text-(--accent-forest) transition-colors flex items-center gap-1.5">
            <Terminal class="w-3.5 h-3.5 text-(--accent-forest)" aria-hidden="true" />
            <span>ArchForge</span>
          </span>
          <span class="text-xs text-(--text-secondary) line-clamp-1">
            {t('projects.layer1Desc')}
          </span>
        </a>
      </li>

      <li class="flex">
        <a
          href="#repo-secret-auditor"
          class="interactive-target w-full p-3.5 rounded-xl bg-(--bg-surface) border border-(--border-subtle) hover:border-(--accent-sky) transition-all flex flex-col gap-1 group shadow-xs focus-visible:outline-2 focus-visible:outline-(--accent-sky)"
        >
          <div class="flex items-center justify-between text-xs text-(--text-muted)">
            <span class="font-semibold text-(--accent-sky)">{lang === 'es' ? 'Capa 2' : 'Layer 2'}</span>
            <span class="text-[11px] font-mono text-(--text-muted)">CI/CD Pipeline</span>
          </div>
          <span class="text-sm font-bold text-(--text-primary) group-hover:text-(--accent-sky) transition-colors flex items-center gap-1.5">
            <ShieldCheck class="w-3.5 h-3.5 text-(--accent-sky)" aria-hidden="true" />
            <span>Repo Secret Auditor</span>
          </span>
          <span class="text-xs text-(--text-secondary) line-clamp-1">
            {t('projects.layer2Desc')}
          </span>
        </a>
      </li>

      <li class="flex">
        <a
          href="#dockerward"
          class="interactive-target w-full p-3.5 rounded-xl bg-(--bg-surface) border border-(--border-subtle) hover:border-(--accent-primary) transition-all flex flex-col gap-1 group shadow-xs focus-visible:outline-2 focus-visible:outline-(--accent-primary)"
        >
          <div class="flex items-center justify-between text-xs text-(--text-muted)">
            <span class="font-semibold text-(--accent-primary)">{lang === 'es' ? 'Capa 3' : 'Layer 3'}</span>
            <span class="text-[11px] font-mono text-(--text-muted)">Container Runtime</span>
          </div>
          <span class="text-sm font-bold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors flex items-center gap-1.5">
            <Container class="w-3.5 h-3.5 text-(--accent-primary)" aria-hidden="true" />
            <span>DockerWard</span>
          </span>
          <span class="text-xs text-(--text-secondary) line-clamp-1">
            {t('projects.layer3Desc')}
          </span>
        </a>
      </li>

      <li class="flex">
        <a
          href="#chat-anonimo"
          class="interactive-target w-full p-3.5 rounded-xl bg-(--bg-surface) border border-(--border-subtle) hover:border-(--accent-forest) transition-all flex flex-col gap-1 group shadow-xs focus-visible:outline-2 focus-visible:outline-(--accent-forest)"
        >
          <div class="flex items-center justify-between text-xs text-(--text-muted)">
            <span class="font-semibold text-(--accent-forest)">{lang === 'es' ? 'Capa 4' : 'Layer 4'}</span>
            <span class="text-[11px] font-mono text-(--text-muted)">Network / E2EE</span>
          </div>
          <span class="text-sm font-bold text-(--text-primary) group-hover:text-(--accent-forest) transition-colors flex items-center gap-1.5">
            <Lock class="w-3.5 h-3.5 text-(--accent-forest)" aria-hidden="true" />
            <span>Chat Anónimo</span>
          </span>
          <span class="text-xs text-(--text-secondary) line-clamp-1">
            {t('projects.layer4Desc')}
          </span>
        </a>
      </li>
    </ol>
  </nav>

  <!-- Defense-in-Depth Architecture Visual Diagram -->
  <div class="rounded-2xl overflow-hidden border border-(--border-subtle) bg-[#0E141D] shadow-sm">
    <div class="px-4 py-3 bg-(--bg-surface) border-b border-(--border-subtle) flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-(--accent-forest) shadow-xs animate-pulse"></span>
        <span class="text-xs font-bold text-(--text-primary)">
          {lang === 'es' ? 'Mapa de Arquitectura: Defensa en Profundidad' : 'Architecture Map: 4-Layer Defense in Depth'}
        </span>
        <span class="text-[11px] text-(--text-muted) hidden md:inline">· {lang === 'es' ? 'Haz clic en cualquier capa para inspeccionar su caso de estudio' : 'Click any tier to inspect its case study'}</span>
      </div>
      <span class="text-[11px] font-mono font-semibold text-(--accent-forest) px-2.5 py-0.5 rounded-full bg-(--accent-forest-bg) border border-(--border-subtle)">
        L1 ➔ L2 ➔ L3 ➔ L4
      </span>
    </div>
    <div class="relative w-full overflow-x-auto">
      <img
        src="/images/defense-in-depth-stack.svg"
        alt="Diagrama de Arquitectura de Defensa en Profundidad en 4 Capas — Henry Pacheco (H3n)"
        width="1200"
        height="530"
        class="w-full min-w-[760px] h-auto block"
        loading="lazy"
      />
    </div>
  </div>

  <div class="flex flex-col gap-10">
    {projects.map((project) => {
      const projectAnchor = project.slug.split('/').pop() || project.slug;
      const isArchforge = projectAnchor === 'archforge';
      const isDockerward = projectAnchor === 'dockerward';
      const isChatAnonimo = projectAnchor === 'chat-anonimo';
      return (
        <article id={projectAnchor} class="ghibli-card p-6 sm:p-8 flex flex-col gap-8 bg-(--bg-surface) scroll-mt-24">
          <!-- Top Overview: Title, Category & GitHub Link -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div class="flex flex-col gap-2">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-2xl sm:text-3xl font-bold text-(--text-primary)">
                  {project.data.title}
                </h3>
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-(--accent-sky-bg) text-(--accent-sky) font-medium border border-(--border-subtle) flex items-center gap-1.5">
                  {isArchforge ? (
                    <Terminal class="w-3.5 h-3.5" aria-hidden="true" />
                  ) : isDockerward ? (
                    <Container class="w-3.5 h-3.5" aria-hidden="true" />
                  ) : isChatAnonimo ? (
                    <Lock class="w-3.5 h-3.5" aria-hidden="true" />
                  ) : (
                    <ShieldCheck class="w-3.5 h-3.5" aria-hidden="true" />
                  )}
                  <span>{project.data.category}</span>
                </span>
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-(--accent-forest-bg) text-(--accent-forest) font-semibold border border-(--border-subtle)">
                  {project.data.status}
                </span>
              </div>
              <p class="text-base text-(--text-secondary) max-w-2xl font-medium">
                {project.data.tagline}
              </p>
            </div>

            <div class="flex items-center gap-2 self-start shrink-0">
              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="interactive-target px-3.5 py-2 rounded-xl text-sm font-semibold bg-(--accent-forest-bg) text-(--accent-forest) border border-(--border-subtle) hover:border-(--accent-forest) transition-all flex items-center gap-1.5 shadow-xs"
                  aria-label={`${t('projects.viewDemo')} (abre en nueva pestaña)`}
                >
                  <ExternalLink class="w-3.5 h-3.5" />
                  <span>{t('projects.viewDemo')}</span>
                </a>
              )}
              <a
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="interactive-target px-4 py-2 rounded-xl text-sm font-semibold bg-(--bg-elevated) text-(--text-primary) border border-(--border-default) hover:border-(--accent-primary) hover:text-(--accent-primary) transition-all flex items-center gap-2 shadow-xs shrink-0"
                aria-label={`${t('projects.viewCode')} (abre en nueva pestaña)`}
              >
                <GithubIcon class="w-4 h-4" />
                <span>{t('projects.viewCode')}</span>
              </a>
            </div>
          </div>

          <!-- Visual Demonstration / Architecture Hero Card -->
          <div class="rounded-xl overflow-hidden border border-(--border-subtle) bg-(--bg-elevated) relative group shadow-sm">
            <img
              src={`/images/projects/card-${projectAnchor}.svg`}
              alt={`Demostración técnica y arquitectura de ${project.data.title}`}
              width="1200"
              height="675"
              class="w-full h-auto object-cover object-top transition-transform duration-300 group-hover:scale-[1.008]"
              loading="lazy"
            />
          </div>

          <!-- Technical Case Study Breakdown -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
            <!-- 1. Problem Statement -->
            <div class="flex flex-col gap-3 p-5 rounded-xl bg-(--bg-card-subtle)/50 border border-(--border-subtle)">
              <div class="flex items-center gap-2 text-(--accent-primary) font-semibold text-sm">
                <ShieldAlert class="w-4 h-4" aria-hidden="true" />
                <h4>{t('projects.problemTitle')}</h4>
              </div>
              <p class="text-sm text-(--text-muted) leading-relaxed">
                {project.data.problemSolved}
              </p>
            </div>

            <!-- 2. Key Architecture Decisions -->
            <div class="flex flex-col gap-3 p-5 rounded-xl bg-(--bg-card-subtle)/50 border border-(--border-subtle)">
              <div class="flex items-center gap-2 text-(--accent-forest) font-semibold text-sm">
                <Layers class="w-4 h-4" aria-hidden="true" />
                <h4>{t('projects.architectureTitle')}</h4>
              </div>
              <ul class="flex flex-col gap-2 text-xs text-(--text-muted) leading-relaxed" role="list">
                {project.data.architectureHighlights.map((item) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-(--accent-forest) mt-0.5">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 3. Technical Learnings -->
            <div class="flex flex-col gap-3 p-5 rounded-xl bg-(--bg-card-subtle)/50 border border-(--border-subtle)">
              <div class="flex items-center gap-2 text-(--accent-sky) font-semibold text-sm">
                <BookOpen class="w-4 h-4" aria-hidden="true" />
                <h4>{t('projects.learningsTitle')}</h4>
              </div>
              <ul class="flex flex-col gap-2 text-xs text-(--text-muted) leading-relaxed" role="list">
                {project.data.keyLearnings.map((item) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-(--accent-sky) mt-0.5">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Tech Stack Badges -->
          <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-(--border-subtle)">
            <span class="text-xs font-semibold text-(--text-muted) mr-1">
              {t('projects.techLabel')}:
            </span>
            {project.data.technologies.map((tech) => (
              <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-(--bg-elevated) text-(--text-secondary) border border-(--border-subtle)">
                {tech}
              </span>
            ))}
          </div>
        </article>
      );
    })}
  </div>
</section>
